generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               Int      @id @default(autoincrement())
  uuid             String   @unique @default(uuid())
  name             String
  kode             String
  refreshToken     String?  @db.Text
  password         String
  type             UserType @default(administrator)
  groupId          Int?
  twoFactorSecret  String?  @db.Text
  twoFactorEnabled Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  group        Group?        @relation(fields: [groupId], references: [id])
  activityLogs ActivityLog[]
  riwayatTransferSaldos RiwayatTransferSaldoServer[]
  riwayatSaldos         RiwayatSaldo[]
  pengumuman          Pengumuman[]
}

model Group {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]
  permissions GroupPermission[]
}

model Permission {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  groups GroupPermission[]
}

model GroupPermission {
  id           Int      @id @default(autoincrement())
  groupId      Int
  permissionId Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  group      Group      @relation(fields: [groupId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([groupId, permissionId])
}

model Member {
  id             Int          @id @default(autoincrement())
  uuid           String       @unique @default(uuid())
  kode           String
  fullname       String
  whatsappnumber String       @unique
  kode_agen      String?
  password       String
  saldo          Int?         @default(0)
  status         MemberStatus @default(unverified)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  riwayatTransaksi        RiwayatTransaksi[]
  notifMemberReads        NotifMemberRead[]
  resetPasswords          ResetPassword[]
  paymentFeeAgenHistories PaymentFeeAgenHistory[]
  promos                  Promo[]
  riwayatSaldos           RiwayatSaldo[]
  activityLogs            ActivityLog[]
  devicesConnected        DeviceConnected[]
  pengumumanRecipients    PengumumanRecipient[]

  @@index([whatsappnumber])
  @@index([kode])
}

enum MemberStatus {
  unverified
  verfied
}

model Bank {
  id        Int      @id @default(autoincrement())
  kode      String?
  nama      String?
  image     String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bankTransferOutlets BankTransferOutlet[]
  riwayatMutasis      RiwayatMutasi[]
}

model BankTransferOutlet {
  id            Int      @id @default(autoincrement())
  bankId        Int?
  accountName   String?
  accountNumber String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  bank            Bank?            @relation(fields: [bankId], references: [id])
  requestDeposits RequestDeposit[]
}

model Kategori {
  id        Int         @id @default(autoincrement())
  kode      String?
  name      String?
  type      ProdukType?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  operators         Operator[]
  produkPascabayars ProdukPascabayar[]
}

model Operator {
  id         Int      @id @default(autoincrement())
  kategoriId Int?
  kode       String?
  name       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  kategori Kategori? @relation(fields: [kategoriId], references: [id])
  produks  Produk[]
  prefixes Prefix[]
}

model Prefix {
  id         Int      @id @default(autoincrement())
  operatorId Int?
  prefix     String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  operator Operator? @relation(fields: [operatorId], references: [id])
}

model Server {
  id        Int           @id @default(autoincrement())
  kode      String?
  name      String?
  status    ServerStatus? @default(active)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  transactions           Transaction[]
  transactionsPascabayar TransactionPascabayar[]
  produks                Produk[]
  produkPascabayars      ProdukPascabayar[]
  riwayatTransferSaldoAsal   RiwayatTransferSaldoServer[] @relation("ServerAsal")
  riwayatTransferSaldoTujuan RiwayatTransferSaldoServer[] @relation("ServerTujuan")
}


enum ServerStatus {
  active
  inactive
}

model Produk {
  id             Int           @id @default(autoincrement())
  operatorId     Int?
  kode           String?
  name           String?
  purchase_price Int?
  markup         Int?
  serverId       Int?
  status         ProdukStatus? @default(active)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  operator              Operator?              @relation(fields: [operatorId], references: [id])
  server                Server?                @relation(fields: [serverId], references: [id])
  iakPrabayarProduks    IakPrabayarProduk[]
  tripayPrabayarProduks TripayPrabayarProduk[]
  digiflazzProducts     DigiflazzProduct[]
  transactions          Transaction[]

  @@index([kode])
  @@index([status])
  @@index([operatorId])
}

enum ProdukType {
  prabayar
  pascabayar
}

enum ProdukStatus {
  active
  inactive
}

model ProdukPascabayar {
  id         Int           @id @default(autoincrement())
  kategoriId Int?
  kode       String?
  name       String?
  fee        Int?
  comission  Int?
  outletFee  Int?
  serverId   Int?
  status     ProdukStatus? @default(active)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  kategori               Kategori?                @relation(fields: [kategoriId], references: [id])
  server                 Server?                  @relation(fields: [serverId], references: [id])
  transactionsPascabayar TransactionPascabayar[]
  iakPascabayarProducts  IakPascabayarProduct[]
  TripayPascabayarProduk TripayPascabayarProduk[]
}

model Transaction {
  id                 Int                @id @default(autoincrement())
  kode               String?
  type               ProdukType?
  produkId           Int?
  riwayatTransaksiId Int?
  nomorTujuan        String?
  ket                String?            @db.Text
  purchase_price     Int?
  selling_price      Int?
  saldo_sebelum      Int?
  saldo_sesudah      Int?
  kodeAgen           String?
  laba               Int?
  status_laba        StatusLaba?        @default(unpaid)
  fee_agen           Int?
  status_fee_agen    FeeAgenStatus?     @default(unpaid)
  serverId           Int?
  status             TransactionStatus? @default(proses)
  trx_id             Int?
  serial_number      String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  produk                Produk?                @relation(fields: [produkId], references: [id])
  server                Server?                @relation(fields: [serverId], references: [id])
  riwayatTransaksi      RiwayatTransaksi?      @relation(fields: [riwayatTransaksiId], references: [id])
  digiflazzTransactions DigiflazzTransaction[]

  @@index([riwayatTransaksiId])
  @@index([status])
}

model TransactionPascabayar {
  id                 Int                @id @default(autoincrement())
  kode               String?
  trId               String?
  produkId           Int?
  riwayatTransaksiId Int?
  nomorTujuan        String?
  trName             String?
  ket                String?            @db.Text
  nominal            Int?
  totalNominal       Int?
  adminFee           Int?
  comission          Int?
  outletComission    Int?
  memberComission    Int?
  noref              String?
  tarif              String?
  daya               Int?
  total              Int?
  saldo_sebelum      Int?
  saldo_sesudah      Int?
  kodeAgen           String?
  laba               Int?
  status_laba        StatusLaba?        @default(unpaid)
  fee_agen           Int?
  status_fee_agen    FeeAgenStatus?     @default(unpaid)
  serverId           Int?
  status             TransactionStatus? @default(proses)
  serial_number      String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  produkPascabayar ProdukPascabayar? @relation(fields: [produkId], references: [id])
  server           Server?           @relation(fields: [serverId], references: [id])
  riwayatTransaksi RiwayatTransaksi? @relation(fields: [riwayatTransaksiId], references: [id])
}

enum StatusLaba {
  paid
  unpaid
}

enum FeeAgenStatus {
  paid
  unpaid
}

enum TransactionStatus {
  proses
  gagal
  sukses
  expired
}

model RequestDeposit {
  id                 Int                @id @default(autoincrement())
  kode               String?
  riwayatTransaksiId Int?
  nominal            Int?
  nominalTambahan    Int?
  status             TransactionStatus? @default(proses)
  bankTransferId     Int?
  waktuRequest       DateTime?
  statusKirim        StatusKirim?       @default(belum_kirim)
  alasanPenolakan    String?            @db.Text
  actionDo           ActionDo?
  count_penolakan    Int?
  waktuKirim         DateTime?
  waktuNotifikasi    DateTime?
  tripayReference    String?            @unique
  tripayMerchantRef  String?
  tripayMethod       String?
  tripayFee          Int?
  checkoutUrl        String?            @db.Text
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  riwayatTransaksi   RiwayatTransaksi?   @relation(fields: [riwayatTransaksiId], references: [id])
  bankTransferOutlet BankTransferOutlet? @relation(fields: [bankTransferId], references: [id])
  riwayatMutasis     RiwayatMutasi[]
}

enum StatusKirim {
  sudah_kirim
  belum_kirim
}

enum ActionDo {
  member
  admin
  almutasi
}

model RiwayatTransaksi {
  id            Int            @id @default(autoincrement())
  memberId      Int?
  tipeTransaksi TipeTransaksi?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  member                 Member?                 @relation(fields: [memberId], references: [id])
  requestDeposits        RequestDeposit[]
  transactions           Transaction[]
  transactionsPascabayar TransactionPascabayar[]
  amraRentalFees         AmraRentalFee[]
  transferSaldos         TransferSaldo[]
  terimaSaldos           TerimaSaldo[]
  riwayatSaldos          RiwayatSaldo[]
}

enum TipeTransaksi {
  deposit
  beli_produk_prabayar
  beli_produk_pascabayar
  rental_amra
  tranfer_saldo
  terima_saldo
}

model RiwayatMutasi {
  id          Int                  @id @default(autoincrement())
  kode        String?
  bankId      Int?
  nominal     Int?
  kodeNominal Int?
  requestId   Int?
  status      RiwayatMutasiStatus?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  bank           Bank?           @relation(fields: [bankId], references: [id])
  requestDeposit RequestDeposit? @relation(fields: [requestId], references: [id])
}

enum RiwayatMutasiStatus {
  deposit
  internal_transaction
}

model AmraRentalFee {
  id                 Int      @id @default(autoincrement())
  riwayatTransaksiId Int?
  biaya              Int?
  ket                String?  @db.Text
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  riwayatTransaksi RiwayatTransaksi? @relation(fields: [riwayatTransaksiId], references: [id])
}

model TransferSaldo {
  id                 Int      @id @default(autoincrement())
  kode               String?
  riwayatTransaksiId Int?
  biaya              Int?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  riwayatTransaksi RiwayatTransaksi? @relation(fields: [riwayatTransaksiId], references: [id])
}

model TerimaSaldo {
  id                 Int      @id @default(autoincrement())
  kode               String?
  riwayatTransaksiId Int?
  biaya              Int?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  riwayatTransaksi RiwayatTransaksi? @relation(fields: [riwayatTransaksiId], references: [id])
}

model RiwayatTransferSaldoServer {
  id                 Int      @id @default(autoincrement())
  trxId              String   @unique
  serverAsalId       Int
  serverTujuanId     Int
  nominal            Int
  saldoSebelumAsal   Int?
  saldoSesudahAsal   Int?
  saldoSebelumTujuan Int?
  saldoSesudahTujuan Int?
  status             String
  keterangan         String?  @db.Text
  userId             Int
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  serverAsal   Server @relation("ServerAsal", fields: [serverAsalId], references: [id])
  serverTujuan Server @relation("ServerTujuan", fields: [serverTujuanId], references: [id])
  user         User   @relation(fields: [userId], references: [id])
}


model Notif {
  id          Int      @id @default(autoincrement())
  title       String?  @db.Text
  description String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  notifMemberReads NotifMemberRead[]
}

model NotifMemberRead {
  id        Int      @id @default(autoincrement())
  notifId   Int?
  memberId  Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  notif  Notif?  @relation(fields: [notifId], references: [id])
  member Member? @relation(fields: [memberId], references: [id])
}

model ResetPassword {
  id             Int                  @id @default(autoincrement())
  memberId       Int?
  password_reset String?
  resetValue     String?
  datetime       DateTime?
  status         ResetPasswordStatus? @default(active)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  member Member? @relation(fields: [memberId], references: [id])
}

enum ResetPasswordStatus {
  active
  inactive
}

model Promo {
  id            Int            @id @default(autoincrement())
  memberId      Int?
  kode_agen     String?
  biaya         Int?
  paymentStatus PaymentStatus? @default(unpaid)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  member Member? @relation(fields: [memberId], references: [id])
}

enum PaymentStatus {
  paid
  unpaid
}

model DigiflazzBrand {
  id        Int      @id @default(autoincrement())
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  digiflazzProducts DigiflazzProduct[]
}

model DigiflazzCategory {
  id        Int      @id @default(autoincrement())
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  digiflazzProducts DigiflazzProduct[]
}

model DigiflazzType {
  id        Int      @id @default(autoincrement())
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  digiflazzProducts DigiflazzProduct[]
}

model DigiflazzProduct {
  id                         Int           @id @default(autoincrement())
  produkId                   Int?
  categoryId                 Int?
  brandId                    Int?
  typeId                     Int?
  name                       String?
  selectedSellerBuyerSkuKode String?
  selectedSellerPrice        Int?
  selectedSellerStartCutOff  DateTime?     @db.Time
  selectedSellerEndCutOff    DateTime?     @db.Time
  status                     ProdukStatus? @default(active)
  createdAt                  DateTime      @default(now())
  updatedAt                  DateTime      @updatedAt

  category                DigiflazzCategory?       @relation(fields: [categoryId], references: [id])
  brand                   DigiflazzBrand?          @relation(fields: [brandId], references: [id])
  type                    DigiflazzType?           @relation(fields: [typeId], references: [id])
  produk                  Produk?                  @relation(fields: [produkId], references: [id])
  digiflazzSellerProducts DigiflazzSellerProduct[]
  digiflazzTransactions   DigiflazzTransaction[]
}

model DigiflazzSeller {
  id        Int                    @id @default(autoincrement())
  name      String?
  status    DigiflazzSellerStatus? @default(unbanned)
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt

  digiflazzSellerProducts DigiflazzSellerProduct[]
  digiflazzTransactions   DigiflazzTransaction[]
}

enum DigiflazzSellerStatus {
  banned
  unbanned
}

model DigiflazzSellerProduct {
  id                  Int       @id @default(autoincrement())
  productDigiflazzId  Int?
  sellerId            Int?
  buyerSkuKode        String?
  price               Int?
  sellerProductStatus Boolean?
  startCutOff         DateTime? @db.Time
  endCutOff           DateTime? @db.Time
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  digiflazzProduct DigiflazzProduct? @relation(fields: [productDigiflazzId], references: [id])
  digiflazzSeller  DigiflazzSeller?  @relation(fields: [sellerId], references: [id])
}

model DigiflazzTransaction {
  id                 Int                @id @default(autoincrement())
  transactionId      Int?
  productDigiflazzId Int?
  sellerId           Int?
  buyerSkuCode       String?
  status             TransactionStatus? @default(proses)
  requestTime        DateTime?
  responseTime       DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  digiflazzProduct DigiflazzProduct? @relation(fields: [productDigiflazzId], references: [id])
  digiflazzSeller  DigiflazzSeller?  @relation(fields: [sellerId], references: [id])
  transaction      Transaction?      @relation(fields: [transactionId], references: [id])
}

model IakPascabayarType {
  id        Int      @id @default(autoincrement())
  type      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  iakPascabayarProducts IakPascabayarProduct[]
}

model IakPascabayarProduct {
  id                 Int           @id @default(autoincrement())
  produkPascabayarId Int?
  code               String?
  name               String?
  status             ProdukStatus? @default(active)
  fee                Int?
  komisi             Int?
  typeId             Int?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  type             IakPascabayarType? @relation(fields: [typeId], references: [id])
  produkPascabayar ProdukPascabayar?  @relation(fields: [produkPascabayarId], references: [id])
}

model IakPrabayarType {
  id        Int      @id @default(autoincrement())
  type      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  iakPrabayarOperators IakPrabayarOperator[]
}

model IakPrabayarOperator {
  id        Int      @id @default(autoincrement())
  name      String?
  typeId    Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  type               IakPrabayarType?    @relation(fields: [typeId], references: [id])
  iakPrabayarProduks IakPrabayarProduk[]
}

model IakPrabayarProduk {
  id         Int           @id @default(autoincrement())
  produkId   Int?
  operatorId Int?
  kode       String?
  name       String?
  nominal    String?
  price      Int?
  status     ProdukStatus? @default(active)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  operator IakPrabayarOperator? @relation(fields: [operatorId], references: [id])
  produk   Produk?              @relation(fields: [produkId], references: [id])
}

model TripayPrabayarKategori {
  id        Int      @id @default(autoincrement())
  name      String?
  type      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tripayPrabayarOperators TripayPrabayarOperator[]
}

model TripayPrabayarOperator {
  id         Int      @id @default(autoincrement())
  kategoriId Int?
  kode       String?
  name       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  kategori              TripayPrabayarKategori? @relation(fields: [kategoriId], references: [id])
  tripayPrabayarProduks TripayPrabayarProduk[]
}

model TripayPrabayarProduk {
  id         Int      @id @default(autoincrement())
  produkId   Int?
  operatorId Int?
  kode       String?
  name       String?
  price      Int?
  deskripsi  String?  @db.Text
  status     String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  operator TripayPrabayarOperator? @relation(fields: [operatorId], references: [id])
  produk   Produk?                 @relation(fields: [produkId], references: [id])
}

model MutationBank {
  id            Int           @id @default(autoincrement())
  code          String?
  bankCode      String?
  bankName      String?
  accountNumber String?
  accountName   String?
  balance       Float?
  type          MutationType?
  amount        Int?
  description   String?       @db.Text
  remark        String?
  bankRef       String?
  lastBalance   Float?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

enum MutationType {
  credit
  debet
}

model Menu {
  id         Int      @id @default(autoincrement())
  name       String?
  path       String?
  icon       String?
  tab        String?
  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  subMenus SubMenu[]
}

model SubMenu {
  id         Int      @id @default(autoincrement())
  menu_id    Int
  name       String?
  path       String?
  icon       String?
  tab        String?
  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  menu Menu @relation(fields: [menu_id], references: [id])
}

model TabMenu {
  id         Int      @id @default(autoincrement())
  name       String?
  icon       String?
  path       String?
  desc       String?
  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt
}

model OtpRegister {
  id          Int      @id @default(autoincrement())
  device_code String
  whatsapp    String
  otp         String
  status      String   @default("active")
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  @@index([device_code])
  @@index([whatsapp])
}

model PaymentFeeAgenHistory {
  id                  Int          @id @default(autoincrement())
  memberId            Int?
  kode                String?
  totalPayment        Int?
  paymentType         PaymentType?
  transaksiPrabayar   Int?
  transaksiPascabayar Int?
  saldo_sebelum_klaim Int?
  saldo_setelah_klaim Int?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  member Member? @relation(fields: [memberId], references: [id])
}

enum PaymentType {
  deposit
  deposit_promo
  withdraw
}

enum UserType {
  administrator
  staff
}

model PengaturanUmum {
  id            Int      @id @default(autoincrement())
  nama_aplikasi String?  @default("Outlet Pulsa")
  deskripsi     String?  @db.Text
  logo          String?  @db.Text
  email         String?
  telepon       String?
  alamat           String?  @db.Text
  bullmq_schedules String?  @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model RiwayatSaldo {
  id               Int                @id @default(autoincrement())
  kode             String
  member_id        Int
  nominal          Int
  saldo_sebelumnya Int
  saldo_setelahnya Int
  status           RiwayatSaldoStatus
  ket              String?            @db.Text
  created_at       DateTime           @default(now())
  updated_at       DateTime           @updatedAt

  riwayat_transaksi_id Int?
  admin_id             Int?

  member            Member            @relation(fields: [member_id], references: [id])
  riwayat_transaksi RiwayatTransaksi? @relation(fields: [riwayat_transaksi_id], references: [id])
  admin             User?             @relation(fields: [admin_id], references: [id])

  @@index([member_id])
  @@map("riwayat_saldo")
}

enum RiwayatSaldoStatus {
  pembelian_pulsa
  deposit
  transfer_pulsa
  pencairan_fee_agen
}

model ActivityLog {
  id          Int      @id @default(autoincrement())
  userId      Int?
  memberId    Int?
  action      String
  entity      String?
  entityId    String?
  description String?  @db.Text
  createdAt   DateTime @default(now())

  user   User?   @relation(fields: [userId], references: [id])
  member Member? @relation(fields: [memberId], references: [id])
}

model TripayPascabayarKategori {
  id        Int      @id @default(autoincrement())
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tripayPascabayarOperators TripayPascabayarOperator[]
}

model TripayPascabayarOperator {
  id         Int      @id @default(autoincrement())
  kategoriId Int?
  kode       String?
  name       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  kategori                TripayPascabayarKategori? @relation(fields: [kategoriId], references: [id])
  tripayPascabayarProduks TripayPascabayarProduk[]
}

model TripayPascabayarProduk {
  id         Int      @id @default(autoincrement())
  produkId   Int?
  operatorId Int?
  kode       String?
  name       String?
  biayaAdmin Int?
  status     String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  operator TripayPascabayarOperator? @relation(fields: [operatorId], references: [id])
  produk   ProdukPascabayar?         @relation(fields: [produkId], references: [id])
}

model WebhookLog {
  id             Int      @id @default(autoincrement())
  provider       String   // Nilai: 'IAK', 'TRIPAY', atau 'DIGIFLAZZ'
  event          String?  // Deskripsi event, misal: 'callback_prabayar'
  transactionRef String?  // Kode referensi transaksi (ref_id, trx_id, atau kode)
  payload        String?  @db.Text // Seluruh isi body request dalam format JSON string
  status         String?  // Hasil proses: 'success', 'failed', 'ignored', 'error'
  message        String?  @db.Text // Pesan tambahan atau error message
  ipAddress      String?  // IP address pengirim webhook
  createdAt      DateTime @default(now())
}

model TakeLaba {
  id               Int      @id @default(autoincrement())
  kode_invoice     String   @unique
  jumlah_laba      Int
  jumlah_transaksi Int
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model DeviceConnected {
  id           Int       @id @default(autoincrement())
  device_code  String    @unique
  member_id    Int?
  device_name  String?
  device_brand String?
  device_model String?
  os_name      String?
  os_version   String?
  app_version  String?
  fcm_token    String?   @db.Text
  last_login   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  member                Member?                 @relation(fields: [member_id], references: [id])
  pengumumanRecipients  PengumumanRecipient[]
}

model Pengumuman {
  @@map("Notification")
  id                Int       @id @default(autoincrement())
  title             String
  body              String    @db.Text
  image_url         String?   @db.Text
  payload           String?   @db.Text // Format JSON string
  pengumuman_type   String    @map("notification_type") // cth: 'Promo', 'Transaction', 'System', 'Broadcast'
  target_type       String    // cth: 'All', 'User', 'Device'
  target_id         String?   // User ID atau Device Code
  created_by        Int?      // Admin User ID
  status            String    @default("Draft") // Draft, Sending, Success, Failed
  sent_at           DateTime?
  start_date        DateTime?
  end_date          DateTime?
  priority          String?   @default("Normal")
  is_active         Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  creator           User?     @relation(fields: [created_by], references: [id])
  recipients        PengumumanRecipient[]
}

model PengumumanRecipient {
  @@map("NotificationRecipient")
  id              Int       @id @default(autoincrement())
  pengumuman_id   Int       @map("notification_id")
  member_id       Int?
  device_code     String?
  status          String    @default("Pending") // Pending, Delivered, Failed, Read
  delivered_at    DateTime?
  read_at         DateTime?
  error_message   String?   @db.Text
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  pengumuman      Pengumuman       @relation(fields: [pengumuman_id], references: [id], onDelete: Cascade)
  member          Member?          @relation(fields: [member_id], references: [id], onDelete: Cascade)
  device          DeviceConnected? @relation(fields: [device_code], references: [device_code], onDelete: Cascade)
}
